#!/usr/bin/env node
/*
 orion-eval-trend: is ORION better or worse than yesterday. Rows (counts, rates, timings, commit, date, note) in docs/evals/trend.jsonl.
   orion-eval-trend run                          run the deterministic replay (never live, never the gate), append a row
   orion-eval-trend record parser --exact 83.6 --write-wrong 7.8 --clarify 12.3 --p50-ms 1500 --note "..."
   orion-eval-trend record live --pass N --total M --note "..."     by hand only
   orion-eval-trend show                         last 10 rows per kind, delta and BETTER / WORSE / SAME (default)
   orion-eval-trend check                        exit 1 if the latest replay row is worse than the previous one
 ORION_TREND_FILE overrides the file (tests).
*/
import { appendFileSync, existsSync, mkdirSync, readFileSync } from "node:fs";
import { execFileSync, spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { KINDS, check, formatTable, makeRow, parseRows, serialize } from "./lib/eval-trend.mjs";

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, "..");
const file = process.env.ORION_TREND_FILE ?? join(root, "docs", "evals", "trend.jsonl");
const [cmd = "show", ...rest] = process.argv.slice(2);
const flag = (n) => { const i = rest.indexOf(`--${n}`); return i >= 0 ? rest[i + 1] : undefined; };
const num = (n) => { const v = flag(n); return v === undefined ? undefined : Number(v); };
const read = () => parseRows(existsSync(file) ? readFileSync(file, "utf8") : "");
const commit = () => { try { return execFileSync("git", ["-C", root, "rev-parse", "--short", "HEAD"], { encoding: "utf8" }).trim(); } catch { return ""; } };
const dirty = () => { try { return execFileSync("git", ["-C", root, "status", "--porcelain", "--untracked-files=no"], { encoding: "utf8" }).trim().length > 0; } catch { return false; } };
const save = (row) => { mkdirSync(dirname(file), { recursive: true }); appendFileSync(file, serialize(row) + "\n"); };
const die = (m, c = 2) => { console.error(`orion-eval-trend: ${m}`); process.exit(c); };

try {
  if (cmd === "run") {
    const t0 = Date.now();
    const r = spawnSync("node", [join(here, "orion-replay"), "--json"], { encoding: "utf8" });
    const line = r.stdout.trim().split("\n").pop();
    let j; try { j = JSON.parse(line); } catch { die(`replay gave no JSON (exit ${r.status}): ${(r.stderr || "").slice(0, 200)}`); }
    const row = makeRow("replay", { cases: j.total, pass: j.pass, fail: j.fail, xfail: j.xfail, xpass: j.xpass, skip: j.skip, durationMs: Date.now() - t0, failing: j.failing }, { commit: commit(), dirty: dirty(), note: flag("note") });
    save(row);
    console.log(`recorded replay: ${row.cases} cases, ${row.pass} pass, ${row.fail} fail, ${row.durationMs} ms`);
    if (r.status !== 0) { console.error(`orion-eval-trend: WARNING the replay exited ${r.status} (row recorded anyway)`); process.exit(r.status || 1); }
  } else if (cmd === "record") {
    const kind = rest.shift();
    if (!KINDS.includes(kind) || kind === "replay") die("record <parser|live> ...");
    const f = kind === "parser" ? { exact: num("exact"), writeWrong: num("write-wrong"), clarify: num("clarify"), p50Ms: num("p50-ms") } : { pass: num("pass"), total: num("total") };
    const row = makeRow(kind, f, { commit: commit(), dirty: dirty(), note: flag("note") });
    save(row); console.log(`recorded ${kind}`);
  } else if (cmd === "show") {
    const { rows, skipped } = read();
    console.log(KINDS.map((k) => formatTable(rows, k)).join("\n\n"));
    if (skipped) console.log(`\n(${skipped} unreadable line(s) skipped)`);
  } else if (cmd === "check") {
    const { rows, skipped } = read();
    const res = check(rows, skipped);
    console.log(`orion-eval-trend check: ${res.reason}`);
    process.exit(res.code);
  } else die("usage: run | record <parser|live> ... | show | check");
} catch (e) { die(e.message); }
